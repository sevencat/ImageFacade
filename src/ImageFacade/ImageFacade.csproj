<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 独立版本线：核心包自己的版本，与各后端解耦。patch/minor 不破坏公开 API（前向兼容），
         后端包依赖它时用下界，因此核心兼容升级后后端不需要重发。见 README「版本与兼容」。 -->
    <Version>0.3.0</Version>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ImageFacade</AssemblyName>
    <RootNamespace>ImageFacade</RootNamespace>
    <Description>与后端无关的图像处理门面：统一的加载/保存、Resize 六模式、绘制与中英文文字 API，换后端不换调用代码。本包是核心抽象，不含任何编解码或渲染依赖。</Description>
    <!-- 纯托管核心：无编解码依赖、无渲染源码（plan §1.3 / §7） -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\WenQuanYiMicroHei.ttf.gz"
                      LogicalName="ImageFacade.Fonts.WenQuanYiMicroHei.ttf.gz" />
  </ItemGroup>

  <ItemGroup>
    <!-- 单测要直接测 ResizePlanner / TextLayouter -->
    <InternalsVisibleTo Include="ImageFacade.Tests" />
    <!-- 托管文字后端直接用字形光栅化结果（Font.Layout / GlyphMask / TextLayout）：
         软后端独立实现自己的渲染，OpenCV 4/5 两份源码各编一遍 -->
    <InternalsVisibleTo Include="ImageFacade.SdcbSimdCodecs" />
    <InternalsVisibleTo Include="ImageFacade.OpenCvSharp" />
    <InternalsVisibleTo Include="ImageFacade.OpenCvSharp5" />
  </ItemGroup>

</Project>
