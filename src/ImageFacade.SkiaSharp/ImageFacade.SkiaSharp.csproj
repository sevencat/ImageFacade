<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ImageFacade.SkiaSharp</AssemblyName>
    <RootNamespace>ImageFacade.SkiaSharp</RootNamespace>
    <DefineConstants>$(DefineConstants);SKIA4</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageFacade\ImageFacade.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\adapters\SkiaShared\**\*.cs"
             Exclude="..\adapters\SkiaShared\bin\**;..\adapters\SkiaShared\obj\**"
             Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
