<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 独立版本线：后端包各自发版，不跟随核心（见 README「版本与兼容」） -->
    <Version>0.3.0</Version>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ImageFacade.OpenCvSharp</AssemblyName>
    <RootNamespace>ImageFacade.OpenCvSharp</RootNamespace>
    <Description>ImageFacade 的 OpenCvSharp4 后端：BGRA Mat 直接进出，原生绘制；半透明形状与虚线不支持，文字用核心字形光栅化（含中文）。</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageFacade\ImageFacade.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" />
    <!-- 原生依赖按 RID 单独引；M6 接入（misc §G） -->
  </ItemGroup>

</Project>
