<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 0.3.0 起与核心及其它后端统一基线（此前是独立的 0.1.x 版本线）。
         对齐之后走全量 `dotnet pack ImageFacade.slnx` 即可，不再需要单独指定 VersionPrefix。 -->
    <Version>0.3.0</Version>
    <!-- Sdcb.SimdCodecs 2.0.0 只提供 net10.0 资产，所以软后端（以及依赖它的示例）不保留 net8.0 目标。 -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>ImageFacade.SdcbSimdCodecs</AssemblyName>
    <RootNamespace>ImageFacade.SdcbSimdCodecs</RootNamespace>
    <Description>ImageFacade 的纯托管后端：自绘渲染（图形/文字/Resize）+ 可插拔编解码（Sdcb.SimdCodecs 格式包按需注册），无原生依赖、AOT 友好、输出确定。</Description>
    <!-- 软后端是回退基准：纯托管、无原生依赖、AOT 友好（plan §1.3 / §M） -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CA2255：模块初始化器是 plan §5.5 刻意选择的"引用即注册回退"机制 -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageFacade\ImageFacade.csproj" />
  </ItemGroup>

  <!-- 打包注意：0.3.0 起本包与核心同版本，nuspec 依赖自动是 `Sevencat.ImageFacade >= 0.3.0`，
       走全量 `dotnet pack ImageFacade.slnx` 即可，不需要再单独指定 VersionPrefix。 -->


  <ItemGroup>
    <!-- OpenCV 后端的 net10.0 目标复用这里的 TrueType 解析/字形光栅化来画中文（plan §6.4） -->
    <InternalsVisibleTo Include="ImageFacade.OpenCvSharp" />
    <InternalsVisibleTo Include="ImageFacade.OpenCvSharp5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只引抽象：具体格式（Png / Jpeg / Bmp / Gif / Webp / Tiff …）由使用方按需引包并注册，
         见 README 的「软后端：按需接入编解码」。本包不自带任何编解码器。 -->
    <PackageReference Include="Sdcb.SimdCodecs.Abstractions" />
  </ItemGroup>

</Project>
