<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ImageFacade.OpenCvSharp5</AssemblyName>
    <RootNamespace>ImageFacade.OpenCvSharp</RootNamespace>
    <DefineConstants>$(DefineConstants);OPENCV5</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageFacade\ImageFacade.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp5" VersionOverride="5.0.0.20261109" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\adapters\OpenCvShared\**\*.cs"
             Exclude="..\adapters\OpenCvShared\bin\**;..\adapters\OpenCvShared\obj\**"
             Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
