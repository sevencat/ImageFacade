<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 独立版本线：后端包各自发版，不跟随核心（见 README「版本与兼容」） -->
    <Version>0.3.0</Version>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ImageFacade.OpenCvSharp5</AssemblyName>
    <RootNamespace>ImageFacade.OpenCvSharp</RootNamespace>
    <Description>ImageFacade 的 OpenCvSharp5 后端：BGRA Mat 直接进出，原生绘制；半透明形状与虚线不支持，文字用核心字形光栅化（含中文）。</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageFacade\ImageFacade.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp5" VersionOverride="5.0.0.20261109" />
  </ItemGroup>

  <ItemGroup>
    <!-- 源码只有一份：放在当前主版本工程下，本工程链接编译（4/5 共用，能力完全一致） -->
    <Compile Include="..\ImageFacade.OpenCvSharp\**\*.cs"
             Exclude="..\ImageFacade.OpenCvSharp\bin\**;..\ImageFacade.OpenCvSharp\obj\**"
             Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
