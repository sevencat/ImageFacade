<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 独立版本线：后端包各自发版，不跟随核心（见 README「版本与兼容」） -->
    <Version>0.3.0</Version>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ImageFacade.ImageSharp2</AssemblyName>
    <RootNamespace>ImageFacade.ImageSharp</RootNamespace>
    <Description>ImageFacade 的 ImageSharp 2.x 后端：纯托管、格式全，适合服务端批处理。使用方需自行确认 Six Labors Split License。</Description>
    <DefineConstants>$(DefineConstants);IMAGESHARP2</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageFacade\ImageFacade.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" VersionOverride="2.1.13" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" VersionOverride="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 源码只有一份：放在当前主版本工程下，本工程链接编译（差异用 DefineConstants 隔离） -->
    <Compile Include="..\ImageFacade.ImageSharp\**\*.cs"
             Exclude="..\ImageFacade.ImageSharp\bin\**;..\ImageFacade.ImageSharp\obj\**"
             Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
