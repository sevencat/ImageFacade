<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ImageFacade.ImageSharp2</AssemblyName>
    <RootNamespace>ImageFacade.ImageSharp</RootNamespace>
    <DefineConstants>$(DefineConstants);IMAGESHARP2</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageFacade\ImageFacade.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" VersionOverride="2.1.13" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" VersionOverride="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\adapters\ImageSharpShared\**\*.cs"
             Exclude="..\adapters\ImageSharpShared\bin\**;..\adapters\ImageSharpShared\obj\**"
             Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
