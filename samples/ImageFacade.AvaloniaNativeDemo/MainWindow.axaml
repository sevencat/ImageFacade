<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ImageFacade.AvaloniaNativeDemo.MainWindow"
        Title="ImageFacade + Avalonia 原生后端 + FFmpeg.AutoGen"
        Width="880"
        Height="540"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <StackPanel Background="#1F2229">
        <Grid ColumnDefinitions="Auto,Auto,*" Margin="12,10">
            <Button x:Name="OpenButton"
                    Content="打开视频…"
                    Click="OnOpenClick" />
            <Button x:Name="PauseButton"
                    Grid.Column="1"
                    Content="暂停"
                    IsEnabled="False"
                    Margin="8,0,0,0"
                    Click="OnPauseClick" />
        </Grid>

        <Border x:Name="VideoHost" Height="420" Background="Black">
            <Image x:Name="VideoView" Stretch="Uniform" IsVisible="False" />
        </Border>

        <TextBlock x:Name="StatusText"
                   Margin="12,6"
                   FontSize="12"
                   Foreground="LightGray" />
    </StackPanel>
</Window>
