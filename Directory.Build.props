<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 版本是每个包自己的事：各工程在自己的 csproj 里用 <Version> 显式声明（见 README「版本与兼容」）。
         这里的 VersionPrefix 只是**兜底**——新工程忘了声明时的默认值，不要指望它统一所有包的版本。
         核心与各后端各自独立发版；核心保持前向兼容时，后端不需要跟着重发。 -->
    <VersionPrefix>0.3</VersionPrefix>

    <!-- 包名统一加 Sevencat. 前缀；工程名 = 包名主干 -->
    <PackageId>Sevencat.$(MSBuildProjectName)</PackageId>

    <!-- 打包策略：本仓库的 src 工程发布到 NuGet（7 个包，同版本号）；
         tests/samples/benchmarks 各自设 IsPackable=false。
         第三方库一律 PackageReference，不打包、不转发其二进制或源码（misc §B）。 -->
    <Authors>ImageFacade contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>image;drawing;canvas;skiasharp;opencv;imagesharp;text;resize;yolo</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!-- 每个包都带：README（安装/能力表/许可证提示）、第三方声明、随源码分发的许可证。
       docs/images 一起打进去，否则 NuGet 页面上 README 的截图会裂。 -->
  <ItemGroup>
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(RepoRoot)THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(RepoRoot)licenses\*" Pack="true" PackagePath="licenses\" Visible="false" />
    <None Include="$(RepoRoot)docs\images\*" Pack="true" PackagePath="docs\images\" Visible="false" />
  </ItemGroup>

</Project>
