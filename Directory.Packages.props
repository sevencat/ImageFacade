<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 中心版本只放"当前主版本"；老/新主版本适配工程用 VersionOverride（见 plan §6.5）。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 核心/软后端：Sdcb.SimdCodecs 2.0 拆成 Abstractions + 按格式 codec 包 -->
    <PackageVersion Include="Sdcb.SimdCodecs" Version="2.0.0" />
    <PackageVersion Include="Sdcb.SimdCodecs.Abstractions" Version="2.0.0" />
    <PackageVersion Include="Sdcb.SimdCodecs.Png" Version="2.0.0" />
    <PackageVersion Include="Sdcb.SimdCodecs.Jpeg" Version="2.0.0" />
    <PackageVersion Include="Sdcb.SimdCodecs.Bmp" Version="2.0.0" />

    <!-- 适配包：当前主版本 -->
    <PackageVersion Include="SkiaSharp" Version="4.155.0" />
    <!-- 原生资产按 RID 引用：适配包不引，由应用/测试决定 -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.155.0" />
    <PackageVersion Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageVersion Include="OpenCvSharp5.runtime.win" Version="5.0.0.20261109" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- 注意：Drawing 3.x 依赖 ImageSharp 4.x；与 ImageSharp 3.1.x 配对的是 Drawing 2.1.3（依赖 >= 3.1.4）。 -->
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.3" />

    <!-- 测试与基准 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.2" />
  </ItemGroup>

</Project>
