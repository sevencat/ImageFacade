<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ImageFacade.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- xUnit1051：这里刻意用局部 CancellationTokenSource 验证取消语义 -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- 测试进程需要原生 Skia 库 -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageFacade\ImageFacade.csproj" />
    <ProjectReference Include="..\..\src\ImageFacade.SkiaSharp\ImageFacade.SkiaSharp.csproj" />
    <!-- BMP 等 Skia 后端未实现的编码格式用 ImageSharp 覆盖 -->
    <ProjectReference Include="..\..\src\ImageFacade.ImageSharp\ImageFacade.ImageSharp.csproj" />
  </ItemGroup>

</Project>
