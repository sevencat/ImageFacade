<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ImageFacade.SdcbSimdCodecs.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CA2255：TestCodecs 用 ModuleInitializer 模拟使用方的"启动即注册" -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- 软后端包只带 Abstractions：格式包由使用方自己引（这正是要测的边界） -->
    <PackageReference Include="Sdcb.SimdCodecs.Png" />
    <PackageReference Include="Sdcb.SimdCodecs.Jpeg" />
    <PackageReference Include="Sdcb.SimdCodecs.Bmp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageFacade\ImageFacade.csproj" />
    <ProjectReference Include="..\..\src\ImageFacade.SdcbSimdCodecs\ImageFacade.SdcbSimdCodecs.csproj" />
  </ItemGroup>

</Project>
