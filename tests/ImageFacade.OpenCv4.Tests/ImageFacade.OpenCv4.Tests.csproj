<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 打不开 x86：OpenCvSharp 的原生库只有 win-x64 资产 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>ImageFacade.Tests.OpenCv</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageFacade\ImageFacade.csproj" />
    <ProjectReference Include="..\..\src\ImageFacade.SdcbSimdCodecs\ImageFacade.SdcbSimdCodecs.csproj" />
    <ProjectReference Include="..\..\src\ImageFacade.OpenCvSharp\ImageFacade.OpenCvSharp.csproj" />
  </ItemGroup>

</Project>
